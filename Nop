local function RESETBLOCK()
     args = {
        [1] = {0, 0, 0, 0, 0, 0},
        [2] = "AllBlocky"
    }
    pcall(function()
        Rep.Remotes.ChangeCharacterBody:InvokeServer(unpack(args))
