                        task.wait(0.01)
                        VirtualInputManager:SendMouseButtonEvent(500, 500, 0, false, game, 0)
                    end
                    task.wait(0.12)
                    thrown = thrown + 1
                end)
            end
            return thrown
        end

        task.spawn(function()
            local collected = collectBombs(BombAmount)

            pcall(function() RootPart.CFrame = origin end)
            task.wait(0.12)

            local thrown = throwBombs()

